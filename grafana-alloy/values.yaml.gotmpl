# Official Grafana Alloy chart configuration
# Single agent: receives logs, traces, and metrics; forwards all three to Grafana Cloud
namespaceOverride: {{ .Environment.Name }}
alloy:
  alloy:
    clustering:
      enabled: false

    # Expose OTLP (traces) and Prometheus remote_write (metrics) ports
    # on top of the container Loki already implicitly needs
    extraPorts:
      - name: otlp-grpc
        port: 4317
        targetPort: 4317
        protocol: TCP
      - name: otlp-http
        port: 4318
        targetPort: 4318
        protocol: TCP
      - name: prom-write
        port: 9999
        targetPort: 9999
        protocol: TCP

    configMap:
      create: true
      content: |-
        // ============================================================
        // LOGS: discover pods, scrape logs, forward to Cloud Loki
        // ============================================================

        // Discover Kubernetes pods and collect their logs
        discovery.kubernetes "pods" {
          role = "pod"
        }

        // Relabel to add useful metadata
        discovery.relabel "pods" {
          targets = discovery.kubernetes.pods.targets

          // Add namespace
          rule {
            source_labels = ["__meta_kubernetes_namespace"]
            target_label  = "namespace"
          }

          // Add pod name
          rule {
            source_labels = ["__meta_kubernetes_pod_name"]
            target_label  = "pod"
          }

          // Add container name
          rule {
            source_labels = ["__meta_kubernetes_pod_container_name"]
            target_label  = "container"
          }

          // Set service_name from standard k8s app label (prevents unknown_service)
          rule {
            source_labels = ["__meta_kubernetes_pod_label_app", "__meta_kubernetes_pod_label_app_kubernetes_io_name"]
            separator     = ";"
            regex         = "([^;]+);?.*"
            target_label  = "service_name"
          }

          // Add app label if exists (legacy/plain "app" label)
          rule {
            source_labels = ["__meta_kubernetes_pod_label_app"]
            target_label  = "app"
          }

          // Set the log path
          rule {
            source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
            target_label  = "__path__"
            separator     = "/"
            replacement   = "/var/log/pods/*$1/*.log"
          }
        }

        // Scrape logs from discovered pods
        loki.source.kubernetes "pods" {
          targets    = discovery.relabel.pods.output
          forward_to = [loki.process.pods.receiver]
        }

        // Process logs - extract trace IDs if present
        loki.process "pods" {
          forward_to = [loki.write.default.receiver]

          // Parse JSON logs
          stage.json {
            expressions = {
              level     = "level",
              timestamp = "timestamp",
              message   = "message",
              trace_id  = "trace_id",
            }
          }

          // level stays a label (low cardinality)
          stage.labels {
            values = {
              level = "",
            }
          }

          // trace_id goes to structured metadata, NOT a label (avoids cardinality blowup)
          stage.structured_metadata {
            values = {
              trace_id = "",
            }
          }
        }

        // Write logs to Grafana Cloud Loki
        loki.write "default" {
          endpoint {
            url = "https://logs-prod-028.grafana.net/loki/api/v1/push"

            basic_auth {
              username = "{{ .Values.alloy.lokiCloudUsername }}"
              password = "{{ .Values.alloy.lokiCloudPassword }}"
            }
          }

          external_labels = {
            env = "{{ .Environment.Name }}",
          }
        }

        // ============================================================
        // TRACES: receive OTLP from apps, forward to Cloud Tempo
        // ============================================================

        otelcol.receiver.otlp "apps" {
          grpc {
            endpoint = "0.0.0.0:4317"
          }
          http {
            endpoint = "0.0.0.0:4318"
          }
          output {
            traces = [otelcol.exporter.otlp.tempo_cloud.input]
          }
        }

        otelcol.exporter.otlp "tempo_cloud" {
          client {
            endpoint = "tempo-prod-19-prod-ap-south-1.grafana.net"
            auth     = otelcol.auth.basic.tempo_creds.handler
          }
        }

        otelcol.auth.basic "tempo_creds" {
          username = "{{ .Values.alloy.tempoCloudUsername }}"
          password = "{{ .Values.alloy.tempoCloudPassword }}"
        }

        // ============================================================
        // METRICS: receive remote_write from Prometheus, forward to Cloud Mimir
        // ============================================================

        prometheus.receive_http "prom_ingest" {
          http {
            listen_address = "0.0.0.0"
            listen_port     = 9999
          }
          forward_to = [prometheus.remote_write.mimir_cloud.receiver]
        }

        prometheus.remote_write "mimir_cloud" {
          endpoint {
            url = "https://prometheus-prod-43-prod-ap-south-1.grafana.net/api/prom/push"

            basic_auth {
              username = "{{ .Values.alloy.mimirCloudUsername }}"
              password = "{{ .Values.alloy.mimirCloudPassword }}"
            }
          }

          external_labels = {
            env = "{{ .Environment.Name }}",
          }
        }

    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: 300m
        memory: 256Mi

    mounts:
      varlog: true
      dockercontainers: true

controller:
  type: "daemonset"
  tolerations:
    - effect: NoSchedule
      operator: Exists
  nodeSelector: {}
  affinity: {}

serviceAccount:
  create: true

rbac:
  create: true