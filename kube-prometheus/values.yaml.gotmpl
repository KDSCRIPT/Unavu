namespaceOverride: "{{ .Environment.Name }}"

prometheus:
  alertmanager:
    enabled: false
  prometheus-pushgateway:
    enabled: false
  kube-state-metrics:
    enabled: false
  prometheus-node-exporter:
    enabled: false

  server:
    global:
      scrape_interval: 5s
      scrape_timeout: 5s
      evaluation_interval: 5s

    remoteWrite:
      - url: "http://grafana-alloy.{{ .Environment.Name }}.svc.cluster.local:9999/api/v1/metrics/write"

    persistentVolume:
      enabled: false

    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi

  serverFiles:
    prometheus.yml:
      scrape_configs:
        - job_name: activity
          metrics_path: /actuator/prometheus
          static_configs:
            - targets: ["activity.{{ .Environment.Name }}.svc.cluster.local:9012"]
        - job_name: feed
          metrics_path: /actuator/prometheus
          static_configs:
            - targets: ["feed.{{ .Environment.Name }}.svc.cluster.local:9011"]
        - job_name: list
          metrics_path: /actuator/prometheus
          static_configs:
            - targets: ["list.{{ .Environment.Name }}.svc.cluster.local:8084"]
        - job_name: notification
          metrics_path: /actuator/prometheus
          static_configs:
            - targets: ["notification.{{ .Environment.Name }}.svc.cluster.local:9010"]
        - job_name: restaurant
          metrics_path: /actuator/prometheus
          static_configs:
            - targets: ["restaurant.{{ .Environment.Name }}.svc.cluster.local:8085"]
        - job_name: review
          metrics_path: /actuator/prometheus
          static_configs:
            - targets: ["review.{{ .Environment.Name }}.svc.cluster.local:8081"]
        - job_name: social-graph
          metrics_path: /actuator/prometheus
          static_configs:
            - targets: ["social-graph.{{ .Environment.Name }}.svc.cluster.local:8083"]
        - job_name: user
          metrics_path: /actuator/prometheus
          static_configs:
            - targets: ["user.{{ .Environment.Name }}.svc.cluster.local:8082"]
        - job_name: gateway-server
          metrics_path: /actuator/prometheus
          static_configs:
            - targets: ["gateway-server.{{ .Environment.Name }}.svc.cluster.local:8072"]
        - job_name: config-server
          metrics_path: /actuator/prometheus
          static_configs:
            - targets: ["config-server.{{ .Environment.Name }}.svc.cluster.local:8071"]